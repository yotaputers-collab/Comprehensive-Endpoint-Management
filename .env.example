# Application Configuration
APP_PORT=3000
APP_HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_DATABASE=endpoint_management
# Create/update tables from the entity definitions on boot (no migrations exist yet)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_TTL_DAYS=7
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10
BCRYPT_ROUNDS=10

# First administrator (created only when the users table is empty)
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change-this-before-first-start

# Agent enrolment (generated + logged if unset)
AGENT_ENROLL_TOKEN=
AGENT_ONLINE_WINDOW_MS=120000

# Advisory source (point at a mirror for air-gapped installs)
OSV_API_BASE=https://api.osv.dev
OSV_TTL_HOURS=24
OSV_DETAIL_CONCURRENCY=4

# Scheduled scanning (SCAN_INTERVAL_MINUTES=0 disables the timer)
SCAN_INTERVAL_MINUTES=1440
SCAN_STALE_AFTER_MINUTES=1440
SCAN_MAX_HOSTS_PER_RUN=50
SCAN_WORKER_INTERVAL_MS=5000
SCAN_JOB_STALE_MS=300000
SCAN_JOB_MAX_ATTEMPTS=3

# DLP Configuration
DLp_RETENTION_PERIOD=90
DLp_REAL_TIME_MONITORING=true

# Vulnerability Scan Configuration
VULNERABILITY_SCAN_INTERVAL=3600000
VULNERABILITY_AUTO_REMEDIATION=false

# Compliance Configuration
ISO27001_ENABLED=true
AUDIT_RETENTION_DAYS=365

# Redis (optional, for caching)
REDIS_HOST=redis
REDIS_PORT=6379
