# Application Configuration
APP_PORT=3000
APP_HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password
DB_DATABASE=endpoint_management
# Create/update tables from the entity definitions on boot (no migrations exist yet)
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10

# DLP Configuration
DLp_RETENTION_PERIOD=90
DLp_REAL_TIME_MONITORING=true

# Vulnerability Scan Configuration
VULNERABILITY_SCAN_INTERVAL=3600000
VULNERABILITY_AUTO_REMEDIATION=false

# Compliance Configuration
ISO27001_ENABLED=true
AUDIT_RETENTION_DAYS=365

# Redis (optional, for caching)
REDIS_HOST=redis
REDIS_PORT=6379
